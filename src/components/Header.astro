---
import Icon from "./Icon.astro";
import { navItems, site } from "../data/site";
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] overflow-x-clip"
>
  <div class="max-w-[1280px] mx-auto px-gutter h-16 md:h-28 2xl:h-36 flex items-center justify-between gap-2 md:gap-space-md min-w-0">
    <div class="flex items-center gap-2 md:gap-space-md min-w-0 flex-1 overflow-hidden">
      <a class="flex items-center gap-2 md:gap-3 min-w-0 max-w-full" href="#home">
        <img
          alt="System D Electrical Logo"
          class="h-10 md:h-20 2xl:h-24 w-auto object-contain shrink-0"
          src={site.logo}
          width="130"
          height="80"
          fetchpriority="low"
          decoding="async"
        />
        <div class="flex flex-col min-w-0 overflow-hidden">
          <span class="font-headline-md text-[14px] sm:text-[16px] md:text-[22px] 2xl:text-[26px] text-primary leading-tight tracking-tight font-extrabold truncate">
            {site.name}
          </span>
        </div>
      </a>
    </div>
    <nav
      id="primary-nav"
      class="hidden xl:flex items-center gap-4 2xl:gap-6"
      aria-label="หลัก"
    >
      {
        navItems.map((item, index) => (
          <a
            class:list={[
              "nav-link relative py-2 whitespace-nowrap font-label-lg text-[16px] leading-6 tracking-wide transition-colors",
              index === 0 ? "is-active" : "",
            ]}
            data-nav-link
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-space-sm shrink-0">
      <a
        class="hidden md:flex items-center gap-2 px-3 2xl:px-4 py-2 2xl:py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high transition-colors font-label-lg text-label-lg text-on-surface whitespace-nowrap"
        href={`tel:${site.phoneTel}`}
      >
        <Icon name="call" class="text-[20px] text-primary" />
        <span>{site.phoneDisplay}</span>
      </a>
      <a
        class="hidden lg:flex items-center gap-2 px-3 2xl:px-4 py-2 2xl:py-2.5 rounded-lg bg-primary-container hover:bg-primary transition-colors text-on-primary font-label-lg text-label-lg whitespace-nowrap"
        href={site.lineUrl}
        rel="noopener"
        target="_blank"
      >
        <img
          alt=""
          class="w-5 h-5 object-contain shrink-0"
          src={site.lineIcon}
          width="20"
          height="20"
        />
        <span>{site.lineId}</span>
      </a>
      <button
        id="menu-toggle"
        class="xl:hidden inline-flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface shrink-0"
        type="button"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="เปิดเมนู"
      >
        <Icon name="menu" class="text-[24px]" data-menu-icon="menu" />
        <Icon name="close" class="text-[24px] hidden" data-menu-icon="close" />
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="xl:hidden hidden border-t border-outline-variant bg-surface/95 backdrop-blur-xl">
    <nav class="max-w-[1280px] mx-auto px-gutter py-space-md flex flex-col gap-1" aria-label="มือถือ">
      {
        navItems.map((item, index) => (
          <a
            class:list={[
              "nav-link rounded-lg px-3 py-3.5 font-label-lg text-[16px] leading-6 text-on-surface hover:bg-surface-container hover:text-primary",
              index === 0 ? "is-active" : "",
            ]}
            data-nav-link
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="mt-2 inline-flex items-center justify-center gap-2 px-3 py-3 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg md:hidden"
        href={`tel:${site.phoneTel}`}
      >
        <Icon name="call" class="text-[18px]" />
        {site.phoneDisplay}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  const menuIcon = toggle?.querySelector('[data-menu-icon="menu"]');
  const closeIcon = toggle?.querySelector('[data-menu-icon="close"]');
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    panel.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "ปิดเมนู" : "เปิดเมนู");
    menuIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  function setActive(href: string) {
    links.forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === href);
    });
  }

  toggle?.addEventListener("click", () => {
    setOpen(panel?.classList.contains("hidden") ?? true);
  });

  const sections = [
    ...new Map(
      [...links]
        .map((link) => {
          const href = link.getAttribute("href");
          const section = href ? document.querySelector<HTMLElement>(href) : null;
          return href && section ? ([href, section] as const) : null;
        })
        .filter((item): item is readonly [string, HTMLElement] => Boolean(item)),
    ).values(),
  ];

  let lockActive = false;
  let lockTimer = 0;
  let ticking = false;

  function headerOffset() {
    const header = document.querySelector("header");
    return (header?.getBoundingClientRect().height ?? 112) + 48;
  }

  function syncActiveFromScroll() {
    if (lockActive) return;
    const offset = headerOffset();
    let current = sections[0] ? `#${sections[0].id}` : "#home";
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= offset) current = `#${section.id}`;
    }
    setActive(current);
  }

  links.forEach((link) => {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href");
      if (href?.startsWith("#")) {
        const target = document.querySelector<HTMLElement>(href);
        if (target) {
          event.preventDefault();
          lockActive = true;
          window.clearTimeout(lockTimer);
          setActive(href);
          target.scrollIntoView({ behavior: "smooth" });
          history.pushState(null, "", href);
          lockTimer = window.setTimeout(() => {
            lockActive = false;
            syncActiveFromScroll();
          }, 700);
        }
      }
      setOpen(false);
    });
  });

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        syncActiveFromScroll();
        ticking = false;
      });
    },
    { passive: true },
  );

  setActive(location.hash || "#home");
  syncActiveFromScroll();
</script>
