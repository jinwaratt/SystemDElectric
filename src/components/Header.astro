---
import { navItems, site } from "../data/site";
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
>
  <div class="max-w-[1280px] mx-auto px-gutter h-28 md:h-36 flex items-center justify-between gap-space-md">
    <div class="flex items-center gap-space-md shrink-0">
      <a class="flex items-center gap-3" href="#home">
        <img
          alt="System D Electrical Logo"
          class="h-20 md:h-24 w-auto object-contain"
          src={site.logo}
          width="96"
          height="96"
        />
        <div class="flex flex-col">
          <span class="font-headline-md text-[22px] md:text-[26px] text-primary leading-tight tracking-tight font-extrabold">
            {site.name}
          </span>
        </div>
      </a>
    </div>
    <nav
      id="primary-nav"
      class="hidden xl:flex items-center gap-6"
      aria-label="หลัก"
    >
      {
        navItems.map((item, index) => (
          <a
            class:list={[
              "nav-link relative py-2 whitespace-nowrap font-label-lg text-[16px] leading-6 tracking-wide transition-colors",
              index === 0 ? "is-active" : "",
            ]}
            data-nav-link
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-space-sm shrink-0">
      <a
        class="hidden md:flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high transition-colors font-label-lg text-label-lg text-on-surface whitespace-nowrap"
        href={`tel:${site.phoneTel}`}
      >
        <span class="material-symbols-outlined text-[20px] text-primary">call</span>
        <span>{site.phoneDisplay}</span>
      </a>
      <a
        class="hidden lg:flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary-container hover:bg-primary transition-colors text-on-primary font-label-lg text-label-lg whitespace-nowrap"
        href={site.lineUrl}
        rel="noopener"
        target="_blank"
      >
        <span class="material-symbols-outlined text-[20px]">chat</span>
        <span>{site.lineId}</span>
      </a>
      <button
        id="menu-toggle"
        class="xl:hidden inline-flex items-center justify-center w-12 h-12 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface"
        type="button"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="เปิดเมนู"
      >
        <span class="material-symbols-outlined" data-menu-icon>menu</span>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="xl:hidden hidden border-t border-outline-variant bg-surface/95 backdrop-blur-xl">
    <nav class="max-w-[1280px] mx-auto px-gutter py-space-md flex flex-col gap-1" aria-label="มือถือ">
      {
        navItems.map((item, index) => (
          <a
            class:list={[
              "nav-link rounded-lg px-3 py-3.5 font-label-lg text-[16px] leading-6 text-on-surface hover:bg-surface-container hover:text-primary",
              index === 0 ? "is-active" : "",
            ]}
            data-nav-link
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="mt-2 inline-flex items-center justify-center gap-2 px-3 py-3 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg md:hidden"
        href={`tel:${site.phoneTel}`}
      >
        <span class="material-symbols-outlined text-[18px]">call</span>
        {site.phoneDisplay}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  const icon = toggle?.querySelector("[data-menu-icon]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    panel.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "ปิดเมนู" : "เปิดเมนู");
    if (icon) icon.textContent = open ? "close" : "menu";
  }

  function setActive(href: string) {
    links.forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === href);
    });
  }

  toggle?.addEventListener("click", () => {
    setOpen(panel?.classList.contains("hidden") ?? true);
  });

  links.forEach((link) => {
    link.addEventListener("click", () => {
      setOpen(false);
      const href = link.getAttribute("href");
      if (href) setActive(href);
    });
  });

  setActive(location.hash || "#home");

  const sections = [...links]
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute("href") ?? ""))
    .filter((section): section is HTMLElement => Boolean(section));

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible?.target.id) return;
      setActive(`#${visible.target.id}`);
    },
    { rootMargin: "-30% 0px -55% 0px", threshold: [0.1, 0.3, 0.6] },
  );

  sections.forEach((section) => observer.observe(section));
</script>
