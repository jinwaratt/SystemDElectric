---
import { processSteps } from "../data/process";
---

<section class="w-full bg-surface py-space-xl" id="process">
  <div class="max-w-[1280px] mx-auto px-gutter flex flex-col gap-space-xl">
    <div class="flex flex-col items-center text-center gap-space-xs max-w-3xl mx-auto">
      <span class="font-label-md text-label-md tracking-widest text-secondary uppercase font-bold">
        STREAMLINED WORKFLOW
      </span>
      <h2
        class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight"
      >
        กระบวนการทำงาน One-Stop Service:
        <span class="block">ออกแบบ + ติดตั้ง ในบริษัทเดียว</span>
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        ไร้รอยต่อ ลดต้นทุน ส่งมอบงานตรงเวลา ควบคุมโดยวิศวกรทุกขั้นตอน
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4 relative">
      {
        processSteps.map((step) => (
          <div class="flex flex-col p-5 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all duration-300 relative group">
            <div class="flex items-center justify-between mb-3">
              <span
                class:list={[
                  "font-headline-lg text-headline-lg font-bold transition-colors",
                  step.highlightNumber
                    ? "text-secondary-container"
                    : "text-primary/30 group-hover:text-primary",
                ]}
              >
                {step.number}
              </span>
              <span
                class:list={[
                  "material-symbols-outlined text-[24px]",
                  step.accent ? "text-secondary-container" : "text-primary",
                ]}
              >
                {step.icon}
              </span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-1.5">{step.title}</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{step.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
