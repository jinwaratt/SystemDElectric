---
const brands = [
  { name: "Schneider Electric", src: "/images/brands/schneider.png" },
  { name: "ABB", src: "/images/brands/abb.png" },
  { name: "Siemens", src: "/images/brands/siemens.png" },
  { name: "Mitsubishi", src: "/images/brands/mitsubishi.png" },
  { name: "Panasonic", src: "/images/brands/panasonic.png" },
  { name: "Eaton", src: "/images/brands/eaton.png" },
  { name: "Thai Yazaki", src: "/images/brands/thai-yazaki.png" },
  { name: "3M", src: "/images/brands/3m.png" },
];
---

<section class="w-full bg-surface-container-lowest py-space-lg">
  <div class="max-w-[1280px] mx-auto px-gutter flex flex-col items-center gap-6">
    <p class="font-headline-sm text-headline-sm text-on-surface text-center">
      เลือกใช้อุปกรณ์มาตรฐานระดับสากลจากพันธมิตรแบรนด์ชั้นนำ
    </p>
    <div class="w-full grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4 items-stretch">
      {
        brands.map((brand) => (
          <div class="px-4 py-5 rounded-lg bg-surface flex items-center justify-center shadow-xs hover:shadow-sm transition-all min-h-24">
            <img
              alt={brand.name}
              class="max-h-10 w-full object-contain"
              loading="lazy"
              src={brand.src}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
