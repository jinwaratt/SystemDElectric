---
import { faqs } from "../data/seo";
---

<section class="w-full bg-surface-container-low py-space-xl" id="faq">
  <div class="max-w-[1280px] mx-auto px-gutter flex flex-col gap-space-lg">
    <div class="flex flex-col items-center text-center gap-space-xs max-w-2xl mx-auto">
      <span class="font-label-md text-label-md tracking-widest text-primary uppercase font-bold">
        FAQ
      </span>
      <h2
        class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight"
      >
        คำถามที่พบบ่อย
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        คำตอบสั้น ๆ สำหรับงานออกแบบและติดตั้งระบบไฟฟ้าอุตสาหกรรม
      </p>
    </div>
    <div class="flex flex-col gap-3 max-w-3xl mx-auto w-full">
      {
        faqs.map((faq) => (
          <details class="group rounded-xl bg-surface shadow-xs border border-outline-variant open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-headline-sm text-headline-sm text-on-surface [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <span class="material-symbols-outlined text-primary shrink-0 transition-transform group-open:rotate-180">
                expand_more
              </span>
            </summary>
            <p class="px-5 pb-5 font-body-md text-body-md text-on-surface-variant">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
