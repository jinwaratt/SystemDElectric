---
import Icon from "./Icon.astro";
import { services } from "../data/services";
---

<section class="w-full bg-surface-container-low py-space-xl" id="services">
  <div class="max-w-[1280px] mx-auto px-gutter flex flex-col gap-space-xl">
    <div class="flex flex-col items-center text-center gap-space-xs max-w-2xl mx-auto">
      <span class="font-label-md text-label-md tracking-widest text-primary uppercase font-bold">
        CORE SERVICES & CAPABILITIES
      </span>
      <h2
        class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight"
      >
        ประเภทงานของเรารองรับทุกความต้องการด้านระบบไฟฟ้า
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        ดูแลครบทุกมิติของระบบไฟฟ้าเพื่อความเสถียรและความปลอดภัยสูงสุดของธุรกิจคุณ
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        services.map((service) => (
          <div class="flex flex-col p-5 rounded-xl bg-surface shadow-xs hover:shadow-md transition-all duration-300 group hover:-translate-y-1">
            <div
              class:list={[
                "w-12 h-12 rounded-lg flex items-center justify-center mb-3 transition-colors",
                service.tone === "primary"
                  ? "bg-tertiary-fixed text-primary group-hover:bg-primary group-hover:text-on-primary"
                  : "bg-secondary-fixed text-secondary group-hover:bg-secondary-container group-hover:text-on-secondary",
              ]}
            >
              <Icon name={service.icon} class="text-[28px]" />
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-1">{service.title}</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
