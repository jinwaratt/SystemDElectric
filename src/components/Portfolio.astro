---

<section class="w-full bg-surface-container-low py-space-xl overflow-clip" id="projects" data-portfolio>
  <div class="max-w-[1280px] mx-auto px-gutter flex flex-col gap-space-lg">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="font-label-md text-label-md tracking-widest text-primary uppercase font-bold">
          PROVEN TRACK RECORD
        </span>
        <h2
          class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight"
        >
          ผลงานของเรา (Project Portfolio)
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          โครงการมาตรฐานคุณภาพที่ส่งมอบตรงเวลา ปลอดภัย 100%
        </p>
      </div>
      <div
        class="flex items-center gap-1.5 p-1 rounded-lg bg-surface-container-high overflow-x-auto self-start md:self-auto"
        role="tablist"
        aria-label="กรองผลงาน"
      >
        {
          filters.map((filter, index) => (
            <button
              class:list={[
                "portfolio-filter px-3.5 py-2 rounded-md font-label-lg text-label-lg transition-colors whitespace-nowrap",
                index === 0
                  ? "bg-surface text-primary font-bold shadow-sm"
                  : "text-on-surface-variant hover:text-on-surface",
              ]}
              data-filter={filter.id}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <article
            class="portfolio-card flex flex-col rounded-xl bg-surface overflow-hidden shadow-sm hover:shadow-md transition-all group"
            data-category={project.category}
          >
            <div class="h-48 bg-surface-container relative overflow-hidden">
              <img
                alt={project.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                src={project.image}
                width="640"
                height="384"
              />
              <div class="absolute top-3 right-3 px-2.5 py-1 rounded bg-surface/90 backdrop-blur-sm text-primary font-label-md text-label-md font-bold shadow-sm">
                {project.badge}
              </div>
            </div>
            <div class="p-5 flex flex-col gap-2 flex-1">
              <span class="font-label-md text-label-md text-secondary font-bold">{project.location}</span>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">{project.title}</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">{project.body}</p>
              <div class="pt-3 mt-auto flex items-center justify-between text-on-surface-variant font-label-md text-label-md">
                <span class="flex items-center gap-1 text-primary">
                  <span class="material-symbols-outlined text-[16px]">verified</span>
                  ส่งมอบเรียบร้อย
                </span>
                <span>{project.year}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-portfolio]");
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>(".portfolio-filter");
    const cards = root.querySelectorAll<HTMLElement>(".portfolio-card");

    function applyFilter(filter: string) {
      cards.forEach((card) => {
        const match = filter === "all" || card.dataset.category === filter;
        card.classList.toggle("hidden", !match);
      });
      buttons.forEach((button) => {
        const active = button.dataset.filter === filter;
        button.setAttribute("aria-selected", String(active));
        button.classList.toggle("bg-surface", active);
        button.classList.toggle("text-primary", active);
        button.classList.toggle("font-bold", active);
        button.classList.toggle("shadow-sm", active);
        button.classList.toggle("text-on-surface-variant", !active);
      });
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "all"));
    });
  }
</script>
