---
import { Font } from "astro:assets";
import "../styles/global.css";
import { getHeroImage } from "../data/heroImage";
import { buildJsonLd } from "../data/seo";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const origin = site.url.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, `${origin}/`).href;
const ogImage = new URL(site.ogImage, `${origin}/`).href;
const jsonLd = buildJsonLd();
const hero = await getHeroImage();
const robots =
  "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="image"
      href={hero.src}
      imagesrcset={hero.srcSet.attribute}
      imagesizes="100vw"
      type="image/webp"
      fetchpriority="high"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(", ")} />
    <meta name="author" content={site.legalName} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <meta name="theme-color" content="#00602b" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content={site.geoRegion} />
    <meta name="geo.placename" content={site.geoPlacename} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="th" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM content" />
    <link rel="sitemap" type="application/xml" href={`${origin}/sitemap.xml`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-noto-sans-thai" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      ข้ามไปยังเนื้อหา
    </a>
    <slot />
  </body>
</html>
